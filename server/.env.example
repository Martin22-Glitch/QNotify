# 复制为 .env 后填写。环境变量名是固定约定，后端与前端都按这些名字读取。
# 所有变量统一前缀 QN_

# 界面访问令牌。手机通过局域网访问核心服务时必须带它。生产环境请改成 32 位随机串。
QN_ACCESS_TOKEN=change-me-before-first-run

# 协议端（OneBot 11）WebSocket 地址。
QN_ADAPTER_WS_URL=ws://127.0.0.1:3001/

# 协议端若配置了 access token，填这里；没有就留空
QN_ADAPTER_TOKEN=

# SQLite 数据库文件路径（相对 server/ 目录）
QN_DB_PATH=data/qnotify.db

# 启动后是否自动补采白名单群的历史消息（按 msg_id 去重）
QN_BACKFILL_ENABLED=true
# 每个群补采最近多少条
QN_BACKFILL_COUNT=50

# 模型层（OpenAI 兼容 或 Anthropic）
# provider=openai 时 base_url 留空用 https://api.openai.com/v1；Ollama 填 http://127.0.0.1:11434/v1
QN_LLM_PROVIDER=openai
QN_LLM_BASE_URL=
QN_LLM_API_KEY=
QN_LLM_MODEL=

# 判定与处理
QN_PIPELINE_ENABLED=true
# 置信度低于此值的判定只进"待确认"，不进待办（0~1）
QN_CONFIDENCE_THRESHOLD=0.7
# 同一发送者在该秒数内的多条消息合并成一个消息块再判定
QN_AGGREGATE_WINDOW_SECONDS=45

# 时区：所有"今天/本周"的边界按它算（部署到 UTC 的 VPS 也不会错位）
QN_TZ=Asia/Shanghai

# 浏览器跨域白名单（逗号分隔）。默认放行本机任意端口；手机通过局域网访问时，
# 把 http://<电脑IP>:5179 也加进来
QN_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
